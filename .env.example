# 複製此檔案，重命名為 .env，並填入你的設定值
# cp .env.example .env

# ── 伺服器設定 ───────────────────────────────────────────────────────────────
# 伺服器監聽的 Port（預設：3000）
# PORT=3000

# ── 暫存檔設定 ───────────────────────────────────────────────────────────────
# 暫存提示檔的儲存目錄（預設：./temp）
# TEMP_FOLDER=./temp

# ── Log 設定 ─────────────────────────────────────────────────────────────────
# Log 層級：debug | info | warn | error（預設：info）
# LOG_LEVEL=info

# Log 格式：text（彩色人類可讀）| json（結構化，適合 log aggregator）
# LOG_FORMAT=text
