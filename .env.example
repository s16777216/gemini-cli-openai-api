# 複製此檔案，重命名為 .env，並填入你的設定值
# cp .env.example .env

# ── 伺服器設定 ───────────────────────────────────────────────────────────────
# 伺服器監聽的 Port（預設：3002）
# PORT=3002

# ── 檔案路徑與儲存設定 ─────────────────────────────────────────────────────────────
# 暫存提示檔的儲存目錄（預設：./temp）
# TEMP_FOLDER=./temp

# SQLite 資料庫的儲存路徑（預設：./data/api_keys.db）
# 在 Docker 環境中，通常會透過 Volume 將 ./data 掛載至容器外以確保持久化
# DATABASE_PATH=./data/api_keys.db

# ── Log 設定 ─────────────────────────────────────────────────────────────────
# Log 層級：debug | info | warn | error（預設：info）
# LOG_LEVEL=info

# Log 格式：text（彩色人類可讀）| json（結構化，適合 log aggregator）
# LOG_FORMAT=text

# ── 安全設定 ─────────────────────────────────────────────────────────────────
# WebUI 登入帳號（預設：admin）
# ROOT_USER=admin

# WebUI 登入密碼（務必修改！）
# ROOT_PASSWORD=your-secret-password

# JWT 安全設定（用於簽署授權 Token）
# JWT_SECRET=a-very-secret-string
